diff --git a/qa/overflow/marketArt.mjs b/qa/overflow/marketArt.mjs
new file mode 100644
index 000000000..d07fd93f0
--- /dev/null
+++ b/qa/overflow/marketArt.mjs
@@ -0,0 +1,61 @@
+// market-art-1111 (scratch, not committed): archiveArt.mjs over several languages and backgrounds in one Metro.
+//   node qa/overflow/marketArt.mjs <cells.json> <outdir> --langs en,ru --bgs k=#000000,w=#ffffff [--port 8441] [--size 320] [--dpr 2]
+// Writes <outdir>/<key>.<lang>.<bg>.png
+import { readFileSync, writeFileSync, mkdirSync } from 'node:fs';
+import { join } from 'node:path';
+import { TREE, serving, startMetro, stopMetro, syncTree, warmBundle } from './lib/tree.mjs';
+import { launch, loadPlaywright } from './lib/browser.mjs';
+const args = process.argv.slice(2);
+const opt = (n, d) => { const i = args.indexOf(`--${n}`); return i >= 0 ? args[i + 1] : d; };
+const [cellsFile, out] = args;
+const port = Number(opt('port', '8441'));
+const size = Number(opt('size', '320'));
+const dpr = Number(opt('dpr', '2'));
+const langs = opt('langs', 'en').split(',');
+const bgs = opt('bgs', 'k=#000000').split(',').map((x) => x.split('='));
+const keep = opt('keep', '') === '1';
+const dyn = process.env.DYN_TITLES ? JSON.parse(readFileSync(process.env.DYN_TITLES, 'utf8')) : null;
+const cells = JSON.parse(readFileSync(cellsFile, 'utf8'));
+mkdirSync(out, { recursive: true });
+let metro = null;
+if (!(await serving(port))) {
+  syncTree();
+  const idx = join(TREE, 'ovf/scenes/index.ts');
+  let s = readFileSync(idx, 'utf8');
+  if (!s.includes("id: 'archive_art'")) {
+    s = s.replace('export const SCENES: SceneEntry[] = [', "export const SCENES: SceneEntry[] = [\n  { id: 'archive_art', group: 'Archive', title: 'The website Archive pictures', langs: ['en'], load: () => require('./archiveArt').scenes },");
+    writeFileSync(idx, s);
+  }
+  metro = await startMetro(port);
+  console.log('metro', metro.child.pid, metro.log);
+  const w = await warmBundle(port);
+  console.log('bundle', w.bytes, w.ms, 'ms');
+}
+try {
+  const { chromium } = loadPlaywright();
+  const browser = await launch(chromium);
+  const her = { userId: null, name: 'Agent', color: '#8e99ae', config: { v: 1, skin: 'skin_sand', hair: 'hair_long', hair_color: 'hair_color_brown', face: 'face_smile', outfit: 'outfit_trench', outfit_color: 'outfit_color_khaki' } };
+  for (const lang of langs) for (const [bn, bg] of bgs) {
+    const page = await browser.newPage({ deviceScaleFactor: dpr, viewport: { width: 1400, height: 1000 } });
+    const errs = [];
+    page.on('pageerror', (e) => errs.push(String(e).slice(0, 300)));
+    await page.addInitScript(([c, h, b, d]) => { globalThis.__archiveCells = c; globalThis.__archiveSubject = h; globalThis.__archiveNoPlate = true; globalThis.__bg = b; if (d) globalThis.__dynTitles = d; }, [cells, her, bg, dyn]);
+    await page.goto(`http://localhost:${port}/ovf.html?scene=archive_art&lang=${lang}&fs=1&device=desk&motion=0&size=${size}`, { waitUntil: 'load', timeout: 180000 });
+    await page.waitForFunction(() => window.__mounted, null, { timeout: 180000, polling: 100 });
+    await page.waitForTimeout(3000);
+    let n = 0;
+    for (const c of cells) {
+      const el = await page.$(`[data-testid="aa-${c.key}"]`);
+      if (!el) { console.log('missing', c.key); continue; }
+      await el.scrollIntoViewIfNeeded();
+      await page.waitForTimeout(100);
+      await el.screenshot({ path: join(out, `${c.key}.${lang}.${bn}.png`) });
+      n++;
+    }
+    console.log(lang, bn, 'shots', n, 'of', cells.length, errs.length ? `page errors: ${errs.slice(0, 3).join(' | ')}` : '');
+    await page.close();
+  }
+  await browser.close();
+} finally {
+  if (metro && !keep) stopMetro(metro);
+}
