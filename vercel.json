{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://ajobkfasquywiawjfdxg.supabase.co; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(join|reset-password|confirm-success)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/agree/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/hello(/?)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/archive",
      "destination": "https://archive.spysocial.app/",
      "statusCode": 301
    },
    {
      "source": "/archive/:path((?!art/|data/).*)",
      "destination": "https://archive.spysocial.app/:path",
      "statusCode": 301
    },
    {
      "source": "/u",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "destination": "/uniques",
      "permanent": false
    },
    {
      "source": "/(support|contact-us|rules|safety|privacy|terms|child-safety|whats-new|roadmap|delete-account|transparency|game-night-rules|ledger|beta|hello|help|reset-password|confirm-success|shop|merch|download|app|get|megan|megans-party)/?",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/((?:join|agree)(?:/.*)?)",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/hello",
      "permanent": false
    },
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/shop",
      "destination": "https://shop.spysocial.app/",
      "permanent": false
    },
    {
      "source": "/merch",
      "destination": "https://shop.spysocial.app/",
      "permanent": false
    },
    {
      "source": "/download",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/get",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/megans-party",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/megan",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!\\.well-known/|static/|assets/|archive/|_host/).*)",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "destination": "/_host/archive.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact-us/index.html"
    },
    {
      "source": "/rules",
      "destination": "/rules/index.html"
    },
    {
      "source": "/safety",
      "destination": "/safety/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/child-safety",
      "destination": "/child-safety/index.html"
    },
    {
      "source": "/whats-new",
      "destination": "/whats-new/index.html"
    },
    {
      "source": "/roadmap",
      "destination": "/roadmap/index.html"
    },
    {
      "source": "/delete-account",
      "destination": "/delete-account/index.html"
    },
    {
      "source": "/transparency",
      "destination": "/transparency/index.html"
    },
    {
      "source": "/game-night-rules",
      "destination": "/game-night-rules/index.html"
    },
    {
      "source": "/ledger",
      "destination": "/ledger/index.html"
    },
    {
      "source": "/beta",
      "destination": "/beta/index.html"
    },
    {
      "source": "/hello(/?)",
      "destination": "/hello/index.html"
    },
    {
      "source": "/join/e/:id",
      "destination": "/join/e/index.html"
    },
    {
      "source": "/join/:code",
      "destination": "/join/index.html"
    },
    {
      "source": "/join",
      "destination": "/join/index.html"
    },
    {
      "source": "/((?!\\.well-known/|static/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
