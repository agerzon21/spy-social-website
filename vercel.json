{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://ajobkfasquywiawjfdxg.supabase.co; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), hid=(), bluetooth=(), midi=(), magnetometer=(), display-capture=(), xr-spatial-tracking=(), browsing-topics=()"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/ledger/(.*)\\.ots",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/ledger/(.*)\\.ndjson\\.gz",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/archive/:dir(art|item|motion|scene|worn)/index.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/archive/:dir(art|item|motion|scene|worn)/:file((?!index\\.json$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=31536000, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/market-art/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/ledger{/}?",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(join|reset-password|confirm-success|profile)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/agree/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/hello(/?)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/archive",
      "destination": "https://archive.spysocial.app/",
      "statusCode": 301
    },
    {
      "source": "/archive/:path((?!art/|data/|item/|worn/|scene/|motion/).*)",
      "destination": "https://archive.spysocial.app/:path",
      "statusCode": 301
    },
    {
      "source": "/market",
      "destination": "https://market.spysocial.app/",
      "statusCode": 301
    },
    {
      "source": "/market/:path*",
      "destination": "https://market.spysocial.app/:path*",
      "statusCode": 301
    },
    {
      "source": "/u",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "destination": "/uniques",
      "permanent": false
    },
    {
      "source": "/(support|contact-us|rules|safety|privacy|terms|child-safety|whats-new|roadmap|press|delete-account|game-night-rules|beta|hello|help|reset-password|confirm-success|shop|merch|download|app|get|megan|megans-party){/}?",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/((?:join|agree|profile)(?:/.*)?)",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/(support|contact-us|rules|safety|privacy|terms|child-safety|whats-new|roadmap|press|delete-account|transparency|game-night-rules|ledger|beta|hello|help|reset-password|confirm-success|shop|merch|download|app|get|megan|megans-party){/}?",
      "has": [
        {
          "type": "host",
          "value": "market.spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/((?:join|agree)(?:/.*)?)",
      "has": [
        {
          "type": "host",
          "value": "market.spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/hello",
      "permanent": false
    },
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/shop",
      "destination": "https://shop.spysocial.app/",
      "permanent": false
    },
    {
      "source": "/merch",
      "destination": "https://shop.spysocial.app/",
      "permanent": false
    },
    {
      "source": "/help{/}?",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/download",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/get",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/beta",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/beta/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/beta/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/megans-party",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/megan",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/ledger{/}?", "has": [{ "type": "host", "value": "archive.spysocial.app" }, { "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_host/pre/archive/ledger/:lang.html" },
    { "source": "/ledger{/}?", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "host", "value": "archive.spysocial.app" }, { "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_host/pre/archive/ledger/:lang.html" },
    { "source": "/ledger{/}?", "has": [{ "type": "host", "value": "archive.spysocial.app" }], "destination": "/_host/pre/archive/ledger/en.html" },
    { "source": "/transparency{/}?", "has": [{ "type": "host", "value": "archive.spysocial.app" }], "destination": "/_host/archive-transparency.html" },
    { "source": "/", "has": [{ "type": "host", "value": "archive.spysocial.app" }, { "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_host/pre/archive/home/:lang.html" },
    { "source": "/", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "host", "value": "archive.spysocial.app" }, { "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_host/pre/archive/home/:lang.html" },
    { "source": "/", "has": [{ "type": "host", "value": "archive.spysocial.app" }], "destination": "/_host/pre/archive/home/en.html" },
    { "source": "/uniques{/}?", "has": [{ "type": "host", "value": "archive.spysocial.app" }, { "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_host/pre/archive/uniques/:lang.html" },
    { "source": "/uniques{/}?", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "host", "value": "archive.spysocial.app" }, { "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_host/pre/archive/uniques/:lang.html" },
    { "source": "/uniques{/}?", "has": [{ "type": "host", "value": "archive.spysocial.app" }], "destination": "/_host/pre/archive/uniques/en.html" },
    { "source": "/", "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_host/pre/market/home/:lang.html" },
    { "source": "/", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_host/pre/market/home/:lang.html" },
    { "source": "/", "has": [{ "type": "host", "value": "market.spysocial.app" }], "destination": "/_host/pre/market/home/en.html" },
    { "source": "/movers/:list(rises|falls|traded|valuable){/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_host/pre/market/movers/:list/:lang.html" },
    { "source": "/movers/:list(rises|falls|traded|valuable){/}?", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_host/pre/market/movers/:list/:lang.html" },
    { "source": "/movers/:list(rises|falls|traded|valuable){/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }], "destination": "/_host/pre/market/movers/:list/en.html" },
    { "source": "/catalogue{/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_host/pre/market/catalogue/:lang.html" },
    { "source": "/catalogue{/}?", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_host/pre/market/catalogue/:lang.html" },
    { "source": "/catalogue{/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }], "destination": "/_host/pre/market/catalogue/en.html" },
    { "source": "/catalogue/:cat(intercepts|outfits|hats|glasses|accessories|hair|facial_hair|borders|backdrops|celebrations|titles){/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_host/pre/market/catalogue/:cat/:lang.html" },
    { "source": "/catalogue/:cat(intercepts|outfits|hats|glasses|accessories|hair|facial_hair|borders|backdrops|celebrations|titles){/}?", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_host/pre/market/catalogue/:cat/:lang.html" },
    { "source": "/catalogue/:cat(intercepts|outfits|hats|glasses|accessories|hair|facial_hair|borders|backdrops|celebrations|titles){/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }], "destination": "/_host/pre/market/catalogue/:cat/en.html" },
    { "source": "/u/:item/:serial{/}?", "has": [{ "type": "host", "value": "archive.spysocial.app" }], "destination": "/_host/archive.html" },
    { "source": "/item/:code{/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_host/pre/market/item/:lang.html" },
    { "source": "/item/:code{/}?", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "host", "value": "market.spysocial.app" }, { "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_host/pre/market/item/:lang.html" },
    { "source": "/item/:code{/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }], "destination": "/_host/pre/market/item/en.html" },
    { "source": "/(movers|movers/[^/]+|catalogue/[^/]+|item/[^/]+){/}?", "has": [{ "type": "host", "value": "market.spysocial.app" }], "destination": "/_host/market.html" },
    { "source": "/support{/}?", "has": [{ "type": "query", "key": "q" }], "destination": "/_pre/support/shell.html" },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_pre/home/:lang.html" },
    { "source": "/:page(privacy|terms|rules|safety|game-night-rules|ledger|transparency|child-safety|contact-us|support|whats-new|roadmap|press|beta|delete-account|join){/}?", "has": [{ "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_pre/:page/:lang.html" },
    { "source": "/", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_pre/home/:lang.html" },
    { "source": "/:page(privacy|terms|rules|safety|game-night-rules|ledger|transparency|child-safety|contact-us|support|whats-new|roadmap|press|beta|delete-account|join){/}?", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_pre/:page/:lang.html" },
    { "source": "/", "destination": "/_pre/home/en.html" },
    { "source": "/:page(privacy|terms|rules|safety|game-night-rules|ledger|transparency|child-safety|contact-us|support|whats-new|roadmap|press|beta|delete-account|join){/}?", "destination": "/_pre/:page/en.html" },
    {
      "source": "/hello(/?)",
      "destination": "/hello/index.html"
    },
    {
      "source": "/join/e/:id",
      "destination": "/join/e/index.html"
    },
    { "source": "/join/:code", "has": [{ "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_pre/join-code/:lang.html" },
    { "source": "/join/:code", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_pre/join-code/:lang.html" },
    { "source": "/join/:code", "destination": "/_pre/join-code/en.html" },
    { "source": "/profile/:username", "has": [{ "type": "query", "key": "lang", "value": "(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:-Hans|-BR)?" }], "destination": "/_pre/profile/:lang.html" },
    { "source": "/profile/:username", "missing": [{ "type": "query", "key": "lang" }], "has": [{ "type": "header", "key": "accept-language", "value": "^\\s*(?<lang>es|ru|zh|hi|ar|fr|bn|pt|id)(?:[-_;,].*)?$" }], "destination": "/_pre/profile/:lang.html" },
    { "source": "/profile/:username", "destination": "/_pre/profile/en.html" },
    { "source": "/(reset-password|confirm-success|join/.+|profile/[^/]+|agree/[^/]+){/}?", "destination": "/_host/www.html" }
  ]
}
