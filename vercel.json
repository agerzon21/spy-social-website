{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/(join|reset-password|confirm-success)(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/agree/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/$1",
      "permanent": false
    },
    {
      "source": "/((?!\\.well-known/).*)",
      "has": [
        {
          "type": "host",
          "value": "archive.spysocial.app"
        }
      ],
      "destination": "https://www.spysocial.app/transparency",
      "permanent": false
    },
    {
      "source": "/megans-party",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/megan",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/beta",
      "destination": "/beta/index.html"
    },
    {
      "source": "/((?!\\.well-known/|static/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
